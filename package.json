{
  "name": "paced-fetch",
  "version": "0.1.0",
  "description": "A fetch that paces requests per API host (rate, concurrency, gap), honors Retry-After, and is configured the same way from env in every server that uses it",
  "license": "MIT",
  "author": "Bill Baran",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wkbaran/paced-fetch.git"
  },
  "keywords": [
    "fetch",
    "rate-limit",
    "throttle",
    "retry-after",
    "429",
    "backoff",
    "mcp"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
